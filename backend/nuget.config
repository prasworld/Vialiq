<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Vialiq EDC Platform - Enterprise NuGet Configuration
    Guarantees deterministic package restoration across developers, local machines, and CI/CD pipelines.
    Strictly clears ambient machine feeds to prevent supply-chain discrepancies.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Package Source Mapping: Directs all packages to official nuget.org -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Package Restore Settings -->
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>

  <!-- Binding Redirects -->
  <bindingRedirects>
    <add key="skip" value="False" />
  </bindingRedirects>

  <!-- Package Management Format: PackageReference (Transitive Dependencies) -->
  <packageManagement>
    <add key="format" value="1" />
    <add key="disabled" value="False" />
  </packageManagement>
</configuration>
