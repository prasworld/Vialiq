{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs"
      ]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "postbuild-publish": {
      "$comment": "dependsOn omits ^build intentionally — each publishable lib defines its own dependsOn on this target, which fully replaces this default per Nx merge rules. Adding ^build here would be silently ignored for all current libs.",
      "cache": true,
      "dependsOn": ["build"]
    },
    "@angular-devkit/build-angular:browser": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/vitest:test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "@nx/angular:webpack-browser": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "env": "NX_MF_DEV_REMOTES"
        }
      ]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "provenance": true
      }
    }
  },
  "plugins": [
    {
      "plugin": "./tools/generators"
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "vitest:test",
        "ciTargetName": "test-ci",
        "testMode": "run"
      }
    }
  ],
  "generators": {
    "@nx/angular:application": {
      "directory": "apps",
      "e2eTestRunner": "playwright",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/js:library": {
      "directory": "libs"
    }
  },
  "release": {
    "projects": ["flux-ui", "state-fp", "automapper", "icons"],
    "projectsRelationship": "independent",
    "version": {
      "versionActions": "tools/release/version-actions.js",
      "preserveMatchingDependencyRanges": true,
      "updateDependents": "never",
      "git": {
        "$comment": "commit: false — no version-bump commit is pushed to master (avoids branch-protection bypass). Tags are the sole source of truth for currentVersionResolver: git-tag. tag: true — nx release version creates annotated local tags only when it actually bumps a version (no-op runs do not call git tag, so existing tags are never duplicated or moved). If a remote tag of the same name already exists at a different SHA it must be repaired manually; this workflow has no --force path.",
        "commit": false,
        "tag": true
      },
      "preVersionCommand": "git fetch --tags --force",
      "generatorOptions": {
        "currentVersionResolver": "git-tag",
        "specifierSource": "conventional-commits"
      },
      "conventionalCommits": {
        "types": {
          "feat": { "semver": "minor" },
          "fix": { "semver": "patch" },
          "refactor": { "semver": "patch" },
          "perf": { "semver": "patch" }
        }
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true
    }
  }
}
