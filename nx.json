{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs"
      ]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "postbuild-publish": {
      "$comment": "dependsOn omits ^build intentionally — each publishable lib defines its own dependsOn on this target, which fully replaces this default per Nx merge rules. Adding ^build here would be silently ignored for all current libs.",
      "cache": true,
      "dependsOn": ["build"]
    },
    "@angular-devkit/build-angular:browser": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/vitest:test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "@nx/angular:webpack-browser": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "env": "NX_MF_DEV_REMOTES"
        }
      ]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "provenance": true
      }
    }
  },
  "plugins": [
    {
      "plugin": "./tools/generators"
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "vitest:test",
        "ciTargetName": "test-ci",
        "testMode": "run"
      }
    }
  ],
  "generators": {
    "@nx/angular:application": {
      "directory": "apps",
      "e2eTestRunner": "playwright",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/js:library": {
      "directory": "libs"
    }
  },
  "release": {
    "projects": ["flux-ui", "state-fp", "automapper", "icons"],
    "projectsRelationship": "independent",
    "conventionalCommits": {
      "ignoreFilePatternsForConventionalCommits": [
        "nx.json",
        "package.json",
        "package-lock.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        ".github/**/*",
        "tools/**/*"
      ],
      "types": {
        "feat":     { "semverBump": "minor" },
        "fix":      { "semverBump": "patch" },
        "refactor": { "semverBump": "patch" },
        "perf":     { "semverBump": "patch" },
        "chore":    { "semverBump": "none" }
      }
    },
    "version": {
      "conventionalCommits": true,
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "git": {
        "commit": false,
        "tag": true
      },
      "preVersionCommand": "git fetch --tags --force"
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true
    }
  }
}
