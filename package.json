{
  "name": "@vialiq/workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "npm@11.11.0",
  "scripts": {
    "prepare": "node tools/scripts/setup-hooks.mjs",
    "start": "nx serve shell",
    "serve": "nx serve shell",
    "serve:prod": "nx run shell:serve-static",
    "build": "nx build shell --configuration=production",
    "build:dev": "nx build shell --configuration=development",
    "test": "nx test shell",
    "clean:vitest": "node ./tools/scripts/clean-vitest.cjs",
    "clean:test": "npm run clean:vitest && npx rimraf coverage && nx reset",
    "test:automapper:cov": "npx nx test automapper --skip-nx-cache -- --coverage --reporter verbose",
    "lint": "nx lint shell",
    "format": "nx format:write",
    "affected:build": "nx affected:build",
    "affected:test": "nx affected:test",
    "build:automapper:publish": "node libs/automapper/build.js",
    "build:prod": "npx nx build automapper --configuration=production --skip-nx-cache && cp libs/automapper/publish-package.json dist/libs/automapper/package.json && (cd dist/libs/automapper && npm pack)",
    "generate:icons": "node libs/icons/tools/generate-icons.mjs"
  },
  "private": true,
