{
  "name": "@vialiq/web-components",
  "version": "0.1.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prasworld/Vialiq.git"
  },
  "type": "module",
  "sideEffects": true,
  "description": "Lit web component library built on @vialiq/flux-ui design tokens",
  "license": "MIT",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./button": {
      "types": "./button/index.d.ts",
      "default": "./button/index.js"
    },
    "./button/vi-button": {
      "types": "./button/vi-button.d.ts",
      "default": "./button/vi-button.js"
    },
    "./icons/vi-icon": {
      "types": "./icons/vi-icon.d.ts",
      "default": "./icons/vi-icon.js"
    },
    "./icons/registry": {
      "types": "./icons/registry.d.ts",
      "default": "./icons/registry.js"
    },
    "./input": {
      "types": "./input/index.d.ts",
      "default": "./input/index.js"
    },
    "./input/vi-input": {
      "types": "./input/vi-input.d.ts",
      "default": "./input/vi-input.js"
    },
    "./radio/vi-radio": {
      "types": "./radio/vi-radio.d.ts",
      "default": "./radio/vi-radio.js"
    },
    "./radio/vi-radio-group": {
      "types": "./radio/vi-radio-group.d.ts",
      "default": "./radio/vi-radio-group.js"
    },
    "./radio": {
      "types": "./radio/index.d.ts",
      "default": "./radio/index.js"
    },
    "./checkbox": {
      "types": "./checkbox/index.d.ts",
      "default": "./checkbox/index.js"
    },
    "./checkbox/vi-checkbox": {
      "types": "./checkbox/vi-checkbox.d.ts",
      "default": "./checkbox/vi-checkbox.js"
    },
    "./textarea": {
      "types": "./textarea/index.d.ts",
      "default": "./textarea/index.js"
    },
    "./textarea/vi-textarea": {
      "types": "./textarea/vi-textarea.d.ts",
      "default": "./textarea/vi-textarea.js"
    },
    "./tooltip": {
      "types": "./tooltip/index.d.ts",
      "default": "./tooltip/index.js"
    },
    "./tooltip/vi-tooltip": {
      "types": "./tooltip/vi-tooltip.d.ts",
      "default": "./tooltip/vi-tooltip.js"
    },
    "./accordion": {
      "types": "./accordion/index.d.ts",
      "default": "./accordion/index.js"
    },
    "./accordion/vi-accordion": {
      "types": "./accordion/vi-accordion.d.ts",
      "default": "./accordion/vi-accordion.js"
    },
    "./badge": {
      "types": "./badge/index.d.ts",
      "default": "./badge/index.js"
    },
    "./badge/vi-badge": {
      "types": "./badge/vi-badge.d.ts",
      "default": "./badge/vi-badge.js"
    },
    "./accordion/vi-accordion-item": {
      "types": "./accordion/vi-accordion-item.d.ts",
      "default": "./accordion/vi-accordion-item.js"
    },
    "./date-picker": {
      "types": "./date-picker/index.d.ts",
      "default": "./date-picker/index.js"
    },
    "./date-picker/vi-date-picker": {
      "types": "./date-picker/vi-date-picker.d.ts",
      "default": "./date-picker/vi-date-picker.js"
    }
  },
  "peerDependencies": {
    "@floating-ui/dom": ">=1.0.0",
    "@vialiq/flux-ui": ">=0.0.4",
    "@vialiq/icons": ">=0.0.3",
    "flatpickr": ">=4.6.0",
    "lit": "^3.0.0"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "microfrontend",
    "flux-ui"
  ],
  "files": [
    "*.js",
    "*.d.ts",
    "base/",
    "button/",
    "icons/",
    "input/",
    "radio/",
    "checkbox/",
    "tooltip/",
    "badge/",
    "date-picker/",
    "README.md"
  ],
  "peerDependenciesMeta": {
    "flatpickr": {
      "optional": false
    }
  }
}
