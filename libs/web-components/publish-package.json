{
  "name": "@vialiq/web-components",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/prasworld/Vialiq.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": true,
  "description": "Lit web component library built on @vialiq/flux-ui design tokens",
  "license": "MIT",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "default": "./index.js",
      "types": "./index.d.ts"
    },
    "./button": {
      "default": "./button/vi-button.js",
      "types": "./button/vi-button.d.ts"
    },
    "./icons/vi-icon": {
      "default": "./icons/vi-icon.js",
      "types": "./icons/vi-icon.d.ts"
    },
    "./icons/registry": {
      "default": "./icons/registry.js",
      "types": "./icons/registry.d.ts"
    }
  },
  "peerDependencies": {
    "lit": "^3.0.0",
    "@vialiq/flux-ui": "*",
    "@vialiq/icons": "*"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "microfrontend",
    "flux-ui"
  ],
  "files": [
    "*.js",
    "*.d.ts",
    "base/",
    "button/",
    "icons/",
    "README.md"
  ]
}
