{
  "name": "automapper",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["libs/automapper/package.json", "libs/automapper/publish-package.json"],
      "currentVersionResolver": "registry"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/automapper",
        "main": "libs/automapper/src/index.ts",
        "additionalEntryPoints": [
          "libs/automapper/src/angular.ts",
          "libs/automapper/src/zod.ts",
          "libs/automapper/src/orm.ts",
          "libs/automapper/src/fetch-adapter.ts",
          "libs/automapper/src/deep-clone.ts"
        ],
        "tsConfig": "libs/automapper/tsconfig.lib.json",
        "assets": ["libs/*.md"],
        "format": ["esm"],
        "thirdPartySourcemaps": false
      },
      "configurations": {
        "production": {
          "minify": true,
          "sourceMap": false,
          "thirdPartySourcemaps": false,
          "optimization": true
        }
      }
    },
    "postbuild-publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "cp libs/automapper/publish-package.json dist/libs/automapper/package.json",
          "cp libs/automapper/LICENSE dist/libs/automapper/LICENSE",
          "cp -r dist/libs/automapper/src/. dist/libs/automapper/"
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/libs/automapper/package.json", "{workspaceRoot}/dist/libs/automapper/LICENSE"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "vitestConfig": "libs/automapper/vitest.config.mts",
        "reportsDirectory": "../../coverage/automapper"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/automapper/**/*.ts"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
