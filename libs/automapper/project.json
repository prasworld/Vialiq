{
  "name": "automapper",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/automapper",
        "main": "libs/automapper/src/index.ts",
        "tsConfig": "libs/automapper/tsconfig.lib.json",
        "assets": ["libs/*.md"],
        "format": ["esm"]
      }
    },
    "postbuild-publish": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cp libs/automapper/publish-package.json dist/libs/automapper/package.json"
        ],
        "parallel": false
      },
      "outputs": ["dist/libs/automapper/package.json"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "vitestConfig": "libs/automapper/vitest.config.mts",
        "reportsDirectory": "../../coverage/automapper"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/automapper/**/*.ts"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
