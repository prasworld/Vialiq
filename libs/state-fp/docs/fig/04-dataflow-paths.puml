@startuml state-fp-dataflow
!define ACCENT_COLOR #4A90E2
!define INPUT_COLOR #E8F5E9
!define PROCESS_COLOR #E3F2FD
!define OUTPUT_COLOR #FFE8B6
!define STORAGE_COLOR #F3E5F5

skinparam monochrome false
skinparam backgroundColor #FEFEFE

'== Write Path ==
(User Event) as input1 --> [Normalize Event] as norm
norm --> [Validate Against Schema] as val
val --> [Execute Command Handler] as exec
exec --> [Produce State Mutation] as mutate
mutate --> [Update Atom._state] as update
update --> {Version Incremented?}
{Version Incremented?} --> [Persist to Storage] as persist1
{Version Incremented?} --> [Broadcast via Sync] as sync_write
persist1 --> [(IndexedDB / LocalStorage)] as storage1

'== Sync Reception Path ==
(Remote Message) as input2 --> [Deserialize SyncMessage] as deser
deser --> [Check Version Vector] as check_ver
check_ver --> {Stale?}
{Stale?} --> [Discard] as discard
{Stale?} --> {Concurrent?}
{Concurrent?} --> [Apply Conflict Strategy] as conflict
{Concurrent?} --> [Merge Versions] as merge_ver
conflict --> [Update Atom._state] as update2
merge_ver --> update2
update2 --> [Merge Version Vectors] as merge_vv
merge_vv --> [Notify Local Subscribers] as notify2
sync_write --> [Transport Selector] as selector
selector --> {BroadcastChannel?}
{BroadcastChannel?} --> [BroadcastChannel.postMessage] as bc_write
{BroadcastChannel?} --> [PostMessage Relay] as pm_write
pm_write --> (Other Tabs/Workers)
bc_write --> (Other Tabs/Workers)

'== Query Path ==
(Read Atom State) as input3 --> [executeQuery] as query_exec
query_exec --> [Check Memo Cache] as memo_check
memo_check --> {Cache Hit?}
{Cache Hit?} --> [Return Cached Result] as cached
{Cache Hit?} --> [Run Query Function] as run_query
run_query --> [Store in Cache with TTL] as cache_store
cache_store --> [Return Result] as query_result
cached --> query_result

'== Subscription Path ==
(subscribe/subscribeAnimated) as input4 --> [Add Listener to Set] as add_listen
add_listen --> [On each emit / RAF frame] as on_emit
on_emit --> {Animated?}
{Animated?} --> [Buffer in AnimatedEntry] as buffer
{Animated?} --> [Synchronous Notify] as sync_notify
buffer --> [requestAnimationFrame] as raf
raf --> [Flush Buffered Values] as flush
flush --> [Call Listener with last value] as call_listen1
sync_notify --> call_listen1

'== DevTools Instrumentation ==
(Mutation / Event) as input5 --> [DomainEvent Emitted] as evt
evt --> [Capture Timestamp] as ts
ts --> [Record in EventLog] as eventlog
eventlog --> [Update State Map] as statemap
statemap --> [(Browser DevTools Ext)] as devtools_out
statemap --> [(Time-Travel Index)] as tt_index

update --> notify2: sync side effect
update --> evt
notify2 --> call_listen1: downstream subscriber

@enduml
