{
  "name": "@vialiq/flux-ui",
  "version": "0.0.1",
  "type": "module",
  "description": "Custom minimal CSS/SASS framework for microfrontend product",
  "license": "MIT",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./tokens": {
      "import": "./tokens/index.js",
      "types": "./tokens/index.d.ts"
    },
    "./styles": "./styles/_index.scss",
    "./styles/*": "./styles/*",
    "./components": "./components/_index.scss",
    "./components/*": "./components/*",
    "./flux-ui.css": "./flux-ui.css"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "index.js.map",
    "index.d.ts.map",
    "*.scss",
    "styles/",
    "components/",
    "tokens/",
    "flux-ui.css",
    "flux-ui.css.map",
    "README.md"
  ]
}
