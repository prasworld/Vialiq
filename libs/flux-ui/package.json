{
  "name": "@vi/flux-ui",
  "version": "0.0.1",
  "type": "module",
  "description": "Custom minimal CSS/SASS framework for microfrontend product",
  "license": "MIT",
  "module": "./index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./index.js"
    },
    "./tokens": {
      "types": "./src/tokens/index.d.ts",
      "default": "./tokens/index.js"
    }
  },
  "files": [
    "index.js",
    "tokens/",
    "styles/",
    "src/**/*.d.ts",
    "README.md"
  ]
}
