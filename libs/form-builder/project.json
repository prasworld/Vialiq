{
  "name": "form-builder",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/form-builder/src",
  "prefix": "vi",
  "projectType": "library",
  "tags": ["scope:form-builder", "type:lib", "framework:angular"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/form-builder/ng-package.json",
        "tsConfig": "libs/form-builder/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/form-builder/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/form-builder/vitest.config.mts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
